# ============================================================
#  Plantilla de variables de entorno.
#  Se copia a un archivo .env con los valores reales.
#  El .env queda fuera de git (.gitignore) por contener secretos.
# ============================================================

# API key de Google AI Studio (Gemini). Se usa para embeddings Y generación.
GEMINI_API_KEY=

# Modelo de generación (opcional; por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
